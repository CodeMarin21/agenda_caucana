generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  ORGANIZADOR
  USUARIO
}

enum EstadoOrganizador {
  PENDIENTE
  VERIFICADO
  SUSPENDIDO
  RECHAZADO
  EN_REVISION
}

enum MotivoEstado {
  INFORMACION_INCOMPLETA
  DOCUMENTO_NO_VERIFICABLE
  ENTIDAD_DUPLICADA
  CONTACTO_DUPLICADO
  DATOS_SOSPECHOSOS
  TYC_INCUMPLIDOS
  EVENTO_FALSO
  CONTENIDO_INAPROPIADO
  QUEJAS_USUARIOS
  INACTIVIDAD
  SOLICITUD_ORGANIZADOR
  OTRO
  SUPLANTACION
  FRAUDE
  MULTIPLES_SUSPENSIONES
  ACTIVIDAD_ILEGAL
  DOCUMENTO_FALSIFICADO
}

enum TipoNotificacion {
  VERIFICACION_APROBADA
  VERIFICACION_RECHAZADA
  EVENTO_APROBADO
  EVENTO_RECHAZADO
  EVENTO_ELIMINADO
  NEGOCIO_APROBADO
  NEGOCIO_RECHAZADO
  NEGOCIO_ELIMINADO
  SUSPENSION
  REACTIVACION
}

enum CategoriaNegocio {
  TRADICIONAL_CAUCANA
  COMIDA_RAPIDA
  PARRILLA
  PIZZA
  SUSHI
  POSTRES
  CAFETERIA
  BEBIDAS
  VEGETARIANA
  OTRO
}

enum EstadoNegocio {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum MotivoReactivacion {
  ERROR_ADMINISTRATIVO
  APELACION_ACEPTADA
  SANCION_CUMPLIDA
  CONDICIONES_CAMBIADAS
  ORDEN_LEGAL
  OTRO
}

enum EstadoPublicacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoBoleta {
  GENERAL
  VIP
  PALCO
}

enum EstadoBoleta {
  DISPONIBLE
  VENDIDA
  CANCELADA
}

// ── Tipo de entidad del organizador ────────────────────
// Afecta reglas de verificación y documentos requeridos.
enum TipoEntidad {
  PERSONA_NATURAL
  FUNDACION
  EMPRESA
  COLECTIVO
  ASOCIACION
  JUNTA_ACCION_COMUNAL
  INSTITUCION_PUBLICA
  OTRO
}

model Ciudad {
  id           Int       @id @default(autoincrement())
  nombre       String    @unique
  departamento String
  activa       Boolean   @default(true)
  creadoEn     DateTime  @default(now())
  eventos      Evento[]
  lugares      Lugar[]
  negocios     Negocio[]

  // Organizadores que declaran este municipio como sede base
  organizadoresBase Organizador[]
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String?
  email         String?  @unique
  passwordHash  String
  rol           Rol      @default(USUARIO)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  organizador         Organizador?
  suscripciones       Suscripcion[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notificaciones      Notificacion[]

  // Organizadores que este admin/ usuario vetó (auditoría de vetos)
  organizadorVetados     Organizador[] @relation("VetoOrganizador")
  organizadorReactivados Organizador[] @relation("ReactivacionOrganizador")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  creadoEn  DateTime @default(now())

  @@index([expiresAt])
}

model Organizador {
  id                  Int               @id @default(autoincrement())
  usuarioId           Int               @unique
  usuario             Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombreEntidad       String
  descripcion         String?
  telefono            String?
  redesSociales       Json?
  nit                 String?
  avatarUrl           String?
  estado              EstadoOrganizador @default(PENDIENTE)
  motivoEstado        MotivoEstado?
  detalleMotivoEstado String?
  creadoEn            DateTime          @default(now())
  actualizadoEn       DateTime          @updatedAt
  eventos             Evento[]
  negocios            Negocio[]

  // ── Perfil ampliado (parámetros de seguridad) ────────
  direccion                 String? // Dirección física de la entidad
  ciudadBaseId              Int? // FK a Ciudad (sede principal)
  ciudadBase                Ciudad?      @relation(fields: [ciudadBaseId], references: [id])
  anioFundacion             Int?
  tipoEntidad               TipoEntidad?
  documentoIdentidadCifrado String? // AES-256-GCM: "<iv-hex>:<authTag-hex>:<data-hex>"
  documentoIdentidadHash    String?      @unique // HMAC-SHA256(normalizado) para unicidad + veto

  // ── Veto (soft-delete + bloqueo de re-registro) ──────
  vetado              Boolean             @default(false)
  motivoVeto          String?
  vetadoEn            DateTime?
  vetadoPorId         Int?
  vetadoPor           Usuario?            @relation("VetoOrganizador", fields: [vetadoPorId], references: [id], onDelete: SetNull)
  motivoReactivacion  MotivoReactivacion?
  detalleReactivacion String?
  reactivadoEn        DateTime?
  reactivadoPorId     Int?
  reactivadoPor       Usuario?            @relation("ReactivacionOrganizador", fields: [reactivadoPorId], references: [id], onDelete: SetNull)

  @@index([vetado, estado])
  @@index([ciudadBaseId])
}

model Notificacion {
  id        Int              @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacion
  mensaje   String
  leida     Boolean          @default(false)
  creadoEn  DateTime         @default(now())

  @@index([usuarioId, leida, creadoEn])
}

model Categoria {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  slug          String        @unique
  descripcion   String?
  icono         String?
  activa        Boolean       @default(true)
  eventos       Evento[]
  suscripciones Suscripcion[]
}

model Lugar {
  id          Int     @id @default(autoincrement())
  nombre      String
  direccion   String
  descripcion String?
  capacidad   Int?
  ciudadId    Int
  ciudad      Ciudad  @relation(fields: [ciudadId], references: [id])
  activo      Boolean @default(true)

  latitud     Float?
  longitud    Float?
  radioMetros Int    @default(100)

  eventos Evento[]

  @@index([ciudadId, activo])
}

model Evento {
  id                      Int               @id @default(autoincrement())
  titulo                  String
  descripcion             String
  imagenUrl               String?
  publicIdImagen          String?
  fechaInicio             DateTime
  fechaFin                DateTime?
  horaApertura            String?
  horaCierre              String?
  direccion               String?
  precioReferencial       Float?
  esMayorDeEdad           Boolean           @default(false)
  urlExternaBoletas       String?
  gestionaTaquillaInterna Boolean           @default(false)
  estadoPublicacion       EstadoPublicacion @default(PENDIENTE)
  motivoRechazo           String?
  slug                    String            @unique
  destacado               Boolean           @default(false)

  ciudadId      Int
  ciudad        Ciudad       @relation(fields: [ciudadId], references: [id])
  categoriaId   Int
  categoria     Categoria    @relation(fields: [categoriaId], references: [id])
  lugarId       Int
  lugar         Lugar        @relation(fields: [lugarId], references: [id])
  organizadorId Int?
  organizador   Organizador? @relation(fields: [organizadorId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  boletas       Boleta[]

  @@index([estadoPublicacion, fechaInicio])
  @@index([categoriaId, estadoPublicacion, fechaInicio])
  @@index([ciudadId, estadoPublicacion, fechaInicio])
  @@index([organizadorId, estadoPublicacion])
  @@index([destacado, estadoPublicacion, fechaInicio])
}

model Negocio {
  id                  Int              @id @default(autoincrement())
  slug                String           @unique
  nombre              String
  descripcion         String
  direccion           String
  ciudadId            Int
  ciudad              Ciudad           @relation(fields: [ciudadId], references: [id])
  telefono            String?
  whatsapp            String?
  instagram           String?
  horarioAtencion     String?
  categoria           CategoriaNegocio
  precioPromedio      Int?
  imagenPrincipalUrl  String?
  imagenesAdicionales Json?
  platos              Json?
  destacado           Boolean          @default(false)
  activo              Boolean          @default(true)
  estadoPublicacion   EstadoNegocio    @default(PENDIENTE)
  motivoRechazo       String?

  organizadorId Int?
  organizador   Organizador? @relation(fields: [organizadorId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  calificaciones CalificacionNegocio[]

  @@index([estadoPublicacion, activo])
  @@index([categoria, estadoPublicacion])
  @@index([ciudadId, estadoPublicacion])
  @@index([organizadorId, estadoPublicacion])
}

model CalificacionNegocio {
  id         Int      @id @default(autoincrement())
  negocioId  Int
  negocio    Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  estrellas  Int
  comentario String?
  ipHash     String
  creadoEn   DateTime @default(now())

  @@index([negocioId, creadoEn])
  @@index([negocioId, ipHash, creadoEn])
}

model Boleta {
  id       Int          @id @default(autoincrement())
  eventoId Int
  evento   Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  tipo     TipoBoleta
  precio   Float
  cantidad Int
  vendidas Int          @default(0)
  estado   EstadoBoleta @default(DISPONIBLE)
  codigoQR String?      @unique
  creadoEn DateTime     @default(now())

  @@index([eventoId, estado])
}

model Suscripcion {
  id          Int       @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  email       String
  activa      Boolean   @default(true)
  creadoEn    DateTime  @default(now())

  @@unique([usuarioId, categoriaId])
  @@index([categoriaId, activa])
}

model ChatLog {
  id        Int      @id @default(autoincrement())
  pregunta  String
  respuesta String
  idioma    String   @default("es")
  ipOrigen  String?
  creadoEn  DateTime @default(now())

  @@index([creadoEn(sort: Desc)])
}

// ── Recuperación de contraseña por email ────────────────
// Token de un solo uso enviado por email. Se guarda HASHED (SHA-256).
// TTL 30 minutos. Al usarse, se invalidan TODOS los refresh tokens
// del usuario (cierra sesiones activas en otros dispositivos).
model PasswordResetToken {
  id            Int      @id @default(autoincrement())
  tokenHash     String   @unique
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  usado         Boolean  @default(false)
  ipSolicitante String?
  creadoEn      DateTime @default(now())

  @@index([usuarioId, expiresAt])
  @@index([expiresAt])
}
