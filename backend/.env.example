DATABASE_URL="postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/agenda_caucana_demo?schema=public"
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Genera valores propios antes de iniciar el backend.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
JWT_EXPIRES_IN=7d
IDENTIDAD_ENCRYPTION_KEY=REEMPLAZAR_POR_64_CARACTERES_HEXADECIMALES

# Opcionales: Gemini habilita respuestas generativas; correo y Cloudinary
# requieren credenciales propias para esas funciones.
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
